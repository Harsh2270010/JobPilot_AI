{
  "name": "JobPilot AI - Analyze Job",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "jobpilot-analyze",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "jobpilot-analyze-webhook",
      "name": "JobPilot Analyze Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        300
      ],
      "webhookId": "jobpilot-analyze"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://crewmate-judge-syndrome.ngrok-free.dev/agent/run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { company: $json.body.company, recruiter_name: $json.body.recruiter_name || '', recruiter_email: $json.body.recruiter_email || '', job_description: $json.body.job_description, resume_text: $json.body.resume_text || '', application_date: $json.body.application_date } }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "jobpilot-agent-request",
      "name": "Run JobPilot Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "jobpilot-analyze-response",
      "name": "Return Analysis",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        800,
        300
      ]
    }
  ],
  "connections": {
    "JobPilot Analyze Webhook": {
      "main": [
        [
          {
            "node": "Run JobPilot Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run JobPilot Agent": {
      "main": [
        [
          {
            "node": "Return Analysis",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}