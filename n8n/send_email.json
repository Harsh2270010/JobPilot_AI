{
  "name": "JobPilot AI - Send Recruiter Email",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "jobpilot-send-email",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "jobpilot-send-webhook",
      "name": "Send Email Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        180,
        300
      ],
      "webhookId": "jobpilot-send-email"
    },
    {
      "parameters": {
        "sendTo": "={{ $json.body.recruiter_email }}",
        "subject": "={{ $json.body.email_subject }}",
        "emailType": "text",
        "message": "={{ $json.body.email_body }}",
        "options": {}
      },
      "id": "jobpilot-gmail-send",
      "name": "Send Recruiter Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://crewmate-judge-syndrome.ngrok-free.dev/email/sent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { application_id: $json.body.application_id } }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "jobpilot-mark-sent",
      "name": "Mark Email Sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        740,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: true, message: 'Email sent successfully', application_id: $('Send Email Webhook').item.json.body.application_id } }}",
        "options": {}
      },
      "id": "jobpilot-send-response",
      "name": "Return Send Result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1020,
        300
      ]
    }
  ],
  "connections": {
    "Send Email Webhook": {
      "main": [
        [
          {
            "node": "Send Recruiter Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Recruiter Email": {
      "main": [
        [
          {
            "node": "Mark Email Sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mark Email Sent": {
      "main": [
        [
          {
            "node": "Return Send Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}