{
  "name": "JobPilot AI - Recruiter Response Monitor",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "filters": {}
      },
      "id": "jobpilot-gmail-trigger",
      "name": "Gmail - New Recruiter Email",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "position": [
        160,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const subject = $json.subject || ''; const from = $json.from || ''; const text = $json.textPlain || $json.text || ''; return [{ json: { recruiter_email: from, subject, recruiter_response: text } }];"
      },
      "id": "jobpilot-normalize-email",
      "name": "Normalize Recruiter Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://crewmate-judge-syndrome.ngrok-free.dev/applications",
        "options": {
          "timeout": 60000
        }
      },
      "id": "jobpilot-get-applications",
      "name": "Get Applications",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const incoming = $('Normalize Recruiter Reply').item.json; const applications = $input.all().map(item => item.json); const email = (incoming.recruiter_email || '').toLowerCase(); let match = null; for (const app of applications) { const recruiterEmail = (app.recruiter_email || '').toLowerCase(); if (recruiterEmail && email.includes(recruiterEmail)) { match = app; break; } } if (!match) { return []; } return [{ json: { application_id: match.id, recruiter_response: incoming.recruiter_response } }];"
      },
      "id": "jobpilot-find-application",
      "name": "Find Matching Application",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://crewmate-judge-syndrome.ngrok-free.dev/response/analyze",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { application_id: $json.application_id, recruiter_response: $json.recruiter_response } }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "jobpilot-response-analysis",
      "name": "Analyze Recruiter Response",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1200,
        300
      ]
    }
  ],
  "connections": {
    "Gmail - New Recruiter Email": {
      "main": [
        [
          {
            "node": "Normalize Recruiter Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Recruiter Reply": {
      "main": [
        [
          {
            "node": "Get Applications",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Applications": {
      "main": [
        [
          {
            "node": "Find Matching Application",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Find Matching Application": {
      "main": [
        [
